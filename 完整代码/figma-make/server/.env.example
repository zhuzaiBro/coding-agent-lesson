PORT=7001

# Main model provider: deepseek | glm | qwen
MAIN_MODEL_PROVIDER=deepseek

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GLM (ZhipuAI)
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
GLM_MODEL=glm-4-flash

# Qwen (DashScope) — text main model when MAIN_MODEL_PROVIDER=qwen
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
# Vision / image analysis (do not use vl models as QWEN_TEXT_MODEL)
QWEN_VL_MODEL=qwen-vl-max
# false required for structured output / tool_choice (thinking mode blocks it)
QWEN_ENABLE_THINKING=false

# Alibaba Cloud OSS
ALI_OSS_AK=
ALI_OSS_SK=
ALI_OSS_BUCKET=
ALI_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# Figma Remote MCP + 网页 OAuth（默认）
FIGMA_MCP_MODE=remote
FIGMA_MCP_URL=https://mcp.figma.com/mcp
# 在 Figma 创建 OAuth 应用后填写（回调 http://localhost:7001/api/figma/oauth/callback）
FIGMA_OAUTH_CLIENT_ID=
FIGMA_OAUTH_CLIENT_SECRET=
# 可选：Personal Access Token 作为 MCP Bearer 备用
FIGMA_API_KEY=

# Supabase Remote MCP (https://supabase.com/docs/guides/ai-tools/mcp)
# Create PAT: https://supabase.com/dashboard/account/tokens
# Project ref: Dashboard → Project Settings → General → Project ID
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Optional: full URL override (default builds from project_ref + read_only)
# SUPABASE_MCP_URL=https://mcp.supabase.com/mcp?project_ref=YOUR_REF&read_only=true&features=database,docs
# true=仅读表结构/SQL查询；false=允许 execute_sql 写数据、apply_migration 改表
SUPABASE_MCP_READ_ONLY=true

# Mock mode fallback
MOCK_MODE=false

# Compile debug fix (LLM repairs files when npm run build fails)
ENABLE_COMPILE_DEBUG_FIX=true
FRONTEND_COMPILE_FIX_MAX_RETRIES=2
FRONTEND_COMPILE_INSTALL_TIMEOUT=180
FRONTEND_COMPILE_BUILD_TIMEOUT=90
