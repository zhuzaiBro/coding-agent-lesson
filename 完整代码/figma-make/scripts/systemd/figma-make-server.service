[Unit]
Description=Figma Make FastAPI Server (uvicorn :7001)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/coding-agent-lesson/完整代码/figma-make/server
Environment=PORT=7001
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env uv run uvicorn main:app --host 0.0.0.0 --port 7001
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
